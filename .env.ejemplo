# Copia este fichero a .env y rellena lo que necesites.
# Todo tiene un valor por defecto razonable: sin .env el proyecto arranca
# con la base local y sin enviar nada por WhatsApp.

# ─── De dónde salen los datos ────────────────────────────────────────────
# "sqlite": base local de este proyecto (la de `npm run seed`).
# "rest":   la API del SaaS que ya está en marcha.
ORIGEN_DATOS=sqlite
RUTA_DB=./datos/araya.sqlite

# Solo si ORIGEN_DATOS=rest
SAAS_API_URL=
SAAS_API_TOKEN=
SAAS_RUTA_COBROS=/facturas/emitidas/pendientes
SAAS_RUTA_PAGOS=/facturas/recibidas/pendientes

# ─── Panel web ───────────────────────────────────────────────────────────
PUERTO=3000
HOST=0.0.0.0
# Si la pones, hay que abrir el panel con ?clave=... la primera vez.
CLAVE_PANEL=
# Enlace al panel donde Yeni entra con su usuario; se incluye en los avisos.
URL_PANEL=

# ─── Informe ─────────────────────────────────────────────────────────────
ZONA_HORARIA=Atlantic/Canary
DIAS_PROXIMO_VENCIMIENTO=7
MAX_LINEAS_WHATSAPP=8

# ─── Correo ──────────────────────────────────────────────────────────────
# Si EMAIL_HOST y EMAIL_DESTINATARIOS están puestos, el envío diario sale
# también por correo, con los dos listados adjuntos en CSV.
EMAIL_HOST=
EMAIL_PUERTO=587
# "si" para el puerto 465 (TLS directo). Con 587 se usa STARTTLS.
EMAIL_SEGURO=no
EMAIL_USUARIO=
EMAIL_CLAVE=
EMAIL_DE=Transportes Araya <avisos@transportesaraya.es>
EMAIL_DESTINATARIOS=
EMAIL_ADJUNTAR_CSV=si

# ─── WhatsApp ────────────────────────────────────────────────────────────
# "consola" (no envía, solo imprime), "meta" o "twilio".
WHATSAPP_PROVEEDOR=consola
# Números en formato internacional, separados por comas.
WHATSAPP_DESTINATARIOS=

# WhatsApp Business Cloud API (Meta)
META_ID_NUMERO=
META_TOKEN=
META_VERSION_API=v21.0
# Nombre de la plantilla aprobada. Sin ella solo se puede escribir dentro
# de la ventana de 24 h desde el último mensaje de la persona.
META_PLANTILLA=
META_IDIOMA=es

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REMITENTE=
